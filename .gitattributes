# Arquivos de texto consistentes entre Windows, Linux e o Godot.
* text=auto
*.gd text eol=lf
*.godot text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.uid text eol=lf
*.import text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.py text eol=lf
*.html text eol=lf
*.js text eol=lf
*.cfg text eol=lf

# Recursos e exportações do jogo devem permanecer binários.
*.png binary
*.jpg binary
*.gif binary
*.ogg binary
*.mp3 binary
*.pck binary
*.wasm binary
